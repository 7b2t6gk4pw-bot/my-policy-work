      <author>Sarah Unsicker</author>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div style="text-align:start;">Priorities</div><ol><li><div style="text-align:start;">Top</div></li><ol><li><div style="text-align:start;">UCCJEA (HB 500)</div></li><li><div style="text-align:start;">Res School Licensing (Greenback Requested)</div></li><li><div style="text-align:start;">Council on Sex Trafficking</div></li><li><div style="text-align:start;">Public Corruption</div></li></ol><li><div style="text-align:start;">Middle</div></li><ol><li><div style="text-align:start;">UCAPA</div></li><ol><li><div style="text-align:start;">Proposed changes sent to ULC and NCMEC 1/1/23</div></li></ol><li><div style="text-align:start;">GAL</div></li><ol><li><div style="text-align:start;"><s>Changes requested from HouseRH 1/1/23</s></div></li><li><div style="text-align:start;">HB 390 (Jim Murphy) / SB 359 (Mary Elizabeth Coleman)</div></li></ol><li><div style="text-align:start;"><span style="--en-highlight:yellow;background-color: #ffef9e;">Wage Theft</span></div></li><li><div style="text-align:start;">Medicaid PHE</div></li><li><div style="text-align:start;">Find people to carry family law and other bills</div></li><li><div style="text-align:start;"><span style="--en-highlight:yellow;background-color: #ffef9e;">Courage2Report</span></div></li></ol><li><div style="text-align:start;">Low</div></li><ol><li><div style="text-align:start;">Missouri Declaration of the Rights of the Child (for Amendment)</div></li><li><div>Postsecondary Expenses </div></li><li><div>Tobacco and Vapor to Drug-Free Schools Act</div></li><li><div>Death Penalty</div></li><li><div>PAMR</div></li><li><div>Midwives</div></li><li><div>Immigrant Tenants</div></li><li><div>Certificate of Value</div></li><li><div style="text-align:start;">St. Louis School Absences</div></li></ol><li><div style="text-align:start;">Other</div></li><ol><li><div style="text-align:start;"><span style="--en-highlight:yellow;background-color: #ffef9e;">Restraint and Seclusion</span></div></li><li><div style="text-align:start;">Compensation for Jurors (not initiated)</div></li><li><div style="text-align:start;">Rules Amendment</div></li><li><div style="text-align:start;"><span style="--en-highlight:yellow;background-color: #ffef9e;">AGO</span></div></li></ol></ol><div style="text-align:start;"><span style="--en-highlight:yellow;background-color: #ffef9e;"><span style="--en-markholder:true;"><br/></span></span></div><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;"><span style="--en-highlight:purple;background-color: #cbcaff;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2146&amp;year=2022&amp;code=R" rev="en_rl_none">HB 2146</a> Foster Children education / BID</span></div></li></ul><div style="text-align:start;"><span style="--en-highlight:purple;background-color: #cbcaff;"><span style="--en-markholder:true;"><br/></span></span></div><div style="text-align:start;"><b>Amend On to things:</b></div><ul><li><div style="text-align:start;">Declaration of the Rights of the Child: 0827H.01Ib</div></li><li><div style="text-align:start;">HB 500</div></li><li><div style="text-align:start;">Possible - limit # continuances in family courts</div></li></ul><div style="text-align:start;"><br/></div><div style="text-align:start;">Work on:</div><ul><li><div style="text-align:start;">UCAPA</div></li><li><div style="text-align:start;">GAL</div></li><li><div style="text-align:start;">BID</div></li></ul><div style="text-align:start;"><br/></div><div style="text-align:start;">Work needed:</div><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;"><span style="--en-highlight:red;background-color: #fec1d0;">2017 HB <a href="https://house.mo.gov/Bill.aspx?bill=HB1121&amp;year=2017&amp;code=R" rev="en_rl_none">1121</a>/<a href="https://house.mo.gov/Bill.aspx?bill=HB1122&amp;year=2017&amp;code=R" rev="en_rl_none">1122</a>: student discipline</span></div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">Lauren Arthur?</div></li></ul><li style="--en-checked:true;"><div style="text-align:start;"><span style="--en-highlight:purple;background-color: #cbcaff;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2026&amp;year=2022&amp;code=R" rev="en_rl_none">UCAPA</a></span></div></li><li style="--en-checked:true;"><div style="text-align:start;"><span style="--en-highlight:purple;background-color: #cbcaff;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2146&amp;year=2022&amp;code=R" rev="en_rl_none">HB 2805</a> GAL</span></div></li><li style="--en-checked:true;"><div style="text-align:start;"><span style="--en-highlight:green;background-color: #b7f7d1;">MDRC</span></div></li><li style="--en-checked:true;"><div style="text-align:start;">Repeal 167.034</div></li></ul><div style="text-align:start;"><br/></div><div style="text-align:start;">1/1 Prep</div><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">1388H.01I </div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Darrell Smith</div></li><li style="--en-checked:false;"><div style="text-align:start;">re: St. Louis City School Absences</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0791H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Curtis Cunningham</div></li><li style="--en-checked:false;"><div style="text-align:start;">re: MOST 529 Postsecondary Expenses (2030 2022)</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">9796H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Curtis Cunningham</div></li><li style="--en-checked:false;"><div style="text-align:start;">re: Drug-Free Schools Act (2440 2020)</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0786H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Adi Schulz</div></li><li style="--en-checked:false;"><div style="text-align:start;">re: Death Penalty</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0783H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Andrew Engler</div></li><li style="--en-checked:false;"><div style="text-align:start;">re: payment for Midwives</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0776H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Adam Speak</div></li><li style="--en-checked:false;"><div style="text-align:start;">re: Voter Registration</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0771H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Matthew Rippentrop</div></li><li style="--en-checked:false;"><div style="text-align:start;">Re: Immigrant Tenants</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0768H.02I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Scott Brinkman</div></li><li style="--en-checked:false;"><div style="text-align:start;">Re: Certificate of Value</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0769H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Scott Brinkman</div></li><li style="--en-checked:false;"><div style="text-align:start;">Re: DOR Report on Tax Credits issued</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">0757H.01I</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">From Darrell Smith</div></li><li style="--en-checked:false;"><div style="text-align:start;">Re: PAMR</div></li></ul><li style="--en-checked:false;"><div style="text-align:start;">Res Licensing</div></li></ul><div style="text-align:start;"><br/></div><div style="text-align:start;">Ready</div><ul style="--en-todo:true;"><li style="--en-checked:true;"><div><span style="--en-highlight:purple;background-color: #cbcaff;">UCCJEA</span></div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div>Karla May - spoke</div></li><li style="--en-checked:false;"><div>Lauren Arthur?</div></li><li style="--en-checked:false;"><div>12/1 Dave Griffith emailed</div></li></ul><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2030&amp;year=2022&amp;code=R" rev="en_rl_none">2022 HB 2030</a> - Postsecondary Expenses</div></li><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2440&amp;year=2020&amp;code=R" rev="en_rl_none">2020 HB 2440</a><span style="color:rgb(0, 0, 0);"> - Tobacco and Vapor to Drug-Free Schools Act</span></div></li><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2028&amp;year=2022&amp;code=R" rev="en_rl_none">2022 HB 2028</a> - Death Penalty</div></li><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB47&amp;year=2021&amp;code=R" rev="en_rl_none">2021 HB 47</a><span style="color:rgb(0, 0, 0);"> - PAMR</span></div></li><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB46&amp;year=2021&amp;code=R" rev="en_rl_none">2021 HB 46</a> - Midwives</div></li><ul style="--en-todo:true;"><li style="--en-checked:true;"><div style="text-align:start;">Bill Request 516 a, 0783H.01I</div></li></ul><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2027&amp;year=2022&amp;code=R" rev="en_rl_none">2022 HB 2027</a><span style="color:rgb(0, 0, 0);"> - Immigrant Tenants</span></div></li><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2029&amp;year=2022&amp;code=R" rev="en_rl_none">2022 HB 2029</a> - Certificate of Value</div></li></ul><div><br/></div><div>Requested:</div><ul style="--en-todo:true;"><ul style="--en-todo:true;"><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB48&amp;year=2021&amp;code=R" rev="en_rl_none">2021 HB 48</a> - DOR Report on Tax Credits</div></li><li><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB23580&amp;year=2020&amp;code=R" rev="en_rl_none">2020 HB 2358</a> - OA Report about disability employment (Missouri as a Model Employer)</div></li><ul><li style="--en-checked:false;"><div style="text-align:start;">Completed, sent to Bridget: 0867H.01I, from Nasreen Esmail (in Completed folder)</div></li></ul><li style="--en-checked:true;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB1051&amp;year=2017&amp;code=R" rev="en_rl_none">2017 HB 1051</a> - Elections <span style="color:rgb(0, 0, 0);"> </span></div></li><ul style="--en-todo:true;"><li style="--en-checked:true;"><div style="text-align:start;"><span style="color:rgb(0, 0, 0);">0776H.01I</span></div></li></ul><li style="--en-checked:true;"><div style="text-align:start;"><span style="--en-highlight:green;background-color: #b7f7d1;">HB 15 - Emily</span></div></li><li style="--en-checked:false;"><div style="text-align:start;"><br/></div></li></ul></ul><div style="text-align:start;"><span style="color:rgb(0, 0, 0);"><span style="--en-markholder:true;"><br/></span></span></div><div style="text-align:start;"><span style="color:rgb(0, 0, 0);">In Process:</span></div><ul style="--en-todo:true;"><li style="--en-checked:true;"><div style="text-align:start;"><span style="color:rgb(0, 0, 0);">Wage Theft - Jim Benoist</span></div></li></ul><div style="--en-task-group:true; --en-id:96c64ac9-90e8-435c-8f8d-10e078a2bac3;--en-content-hash:37fd4d4eb673e137a82e9f47a937b595;-webkit-user-modify:read-only;-moz-user-modify:read-only;user-modify:read-only;border-radius:3px;border:1px solid rgba(182,182,182,0.09);background:rgba(174,174,174,0.09);overflow:hidden;color:#868686"><div style="background:rgba(182,182,182,0.09) no-repeat 6px 6px url(&quot;data:image/svg+xml;base64,&quot;);padding:8px 38px;font-weight:600">Content not supported</div><div style="padding:2px 6px;margin: 1em">This block is a placeholder for Tasks, which has been officially released on the newest version of Evernote and is no longer supported on this version. Deleting or moving this block may cause unexpected behavior in newer versions of Evernote.</div></div><ul style="--en-todo:true;"><li style="--en-checked:true;"><div style="text-align:start;">Circumvent AG - Casey</div></li><li style="--en-checked:true;"><div style="text-align:start;">Rules amendment - Emily</div></li></ul><div style="text-align:start;"><br/></div><div style="text-align:start;"><span style="color:rgb(0, 0, 0);">We also need:</span></div><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB2439&amp;year=2020&amp;code=R" rev="en_rl_none">2020 HB 2439</a> Medicaid eligibility 208.147 (2022 SB 935, 982)</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;"><a href="https://house.mo.gov/Bill.aspx?bill=HB42&amp;year=2021&amp;code=R" rev="en_rl_none">2021 HB 42</a> adds 12 months continuous eligibility for kids and SMHB</div></li><li style="--en-checked:false;"><div style="text-align:start;">People</div></li><ul style="--en-todo:true;"><li style="--en-checked:false;"><div style="text-align:start;">LaKeysha</div></li><li style="--en-checked:false;"><div style="text-align:start;">Lauren Arthur</div></li><li style="--en-checked:false;"><div style="text-align:start;">Deb</div></li></ul></ul></ul><div style="text-align:start;"><br/></div><div style="text-align:start;"><br/></div></en-note>      ]]>
