      <div style="box-sizing:border-box;margin-bottom:20px;background-color:rgb(239, 243, 246);border:1px solid transparent;border-radius:0px;box-shadow:rgba(0, 0, 0, 0.05) 0px 1px 1px;border-color:rgb(207, 207, 207);overflow-wrap:break-word;"> 
        
        <div style="box-sizing:border-box;border-bottom:1px solid transparent;color:rgb(51, 51, 51);background-color:rgb(218, 225, 230);border-color:rgb(207, 207, 207);padding:18px 15px;">
          <h2 style="box-sizing:border-box;font-family:&quot;Francois One&quot;, Arial, Helvetica, sans-serif;font-weight:500;line-height:1.1;margin:0px;border-bottom:none;font-size:22px;color:rgb(68, 68, 68);">Council Public Meetings</h2>
          
        </div>
        <div style="box-sizing:border-box;padding-left:0px;margin-bottom:0px;">
          <div title="attend council meetings" style="box-sizing:border-box;position:relative;display:block;padding:10px 15px;margin-bottom:-1px;background-color:rgb(239, 243, 246);border:1px solid rgb(207, 207, 207);border-top-right-radius:0px;border-top-left-radius:0px;border-width:1px 0px;border-radius:0px;border-top-width:0px;"><p style="box-sizing:border-box;margin:0px 0px 10px;">The public is invited to attend council meetings which are held virtually.</p>
          <p style="box-sizing:border-box;margin:0px 0px 10px;">All guest attendees will be placed on mute upon entry and are encouraged to submit questions or comments through the chat feature. If time permits, after the final agenda discussion, the council will open the floor to public questions or comments. Comments or questions can also be submitted in advance to <a href="https://dps.mo.gov/dir/programs/cvsu/council.phpmailto:cvsu@dps.mo.gov" style="background-color:transparent;box-sizing:border-box;color:rgb(30, 58, 98);text-decoration:none;font-weight:bold;word-break:normal;">cvsu@dps.mo.gov</a></p>
          <p style="box-sizing:border-box;margin:0px 0px 10px;">New dates will be provided as they become available.</p></div>  
          <div title="December 1, 2022" style="box-sizing:border-box;position:relative;display:block;padding:10px 15px;margin-bottom:-1px;background-color:rgb(239, 243, 246);border:1px solid rgb(207, 207, 207);border-width:1px 0px;border-radius:0px;"><a href="https://stateofmo.webex.com/stateofmo/j.php?MTID=mbd028e8534dacc13fa6c2b265393ebb3" style="background-color:transparent;box-sizing:border-box;color:rgb(30, 58, 98);text-decoration:none;font-weight:bold;word-break:normal;">December 1, 2022 - 10:30 am to 11:30 am</a></div>  
          <div title="October 17, 2022" style="box-sizing:border-box;position:relative;display:block;padding:10px 15px;background-color:rgb(239, 243, 246);border:1px solid rgb(207, 207, 207);border-bottom-right-radius:0px;border-bottom-left-radius:0px;margin-bottom:0px;border-width:1px 0px;border-radius:0px;border-bottom:0px;"><a href="https://stateofmo.webex.com/stateofmo/j.php?MTID=mdef0e65cc9283a98a46c9c3569e87caf" style="background-color:transparent;box-sizing:border-box;color:rgb(30, 58, 98);text-decoration:none;font-weight:bold;word-break:normal;">October 17, 2022</a></div>
        </div>
      </div>  
        
       <div style="box-sizing:border-box;margin-bottom:20px;background-color:rgb(239, 243, 246);border:1px solid transparent;border-radius:0px;box-shadow:rgba(0, 0, 0, 0.05) 0px 1px 1px;border-color:rgb(207, 207, 207);overflow-wrap:break-word;"> 
        
        <div style="box-sizing:border-box;border-bottom:1px solid transparent;color:rgb(51, 51, 51);background-color:rgb(218, 225, 230);border-color:rgb(207, 207, 207);padding:18px 15px;">
          <h2 style="box-sizing:border-box;font-family:&quot;Francois One&quot;, Arial, Helvetica, sans-serif;font-weight:500;line-height:1.1;margin:0px;border-bottom:none;font-size:22px;color:rgb(68, 68, 68);">Meeting Minutes</h2>
          
